server {
  listen 8095;
  root /usr/share/nginx/html;
  # Revalidate UI files after an upgrade; old JS must not mask new telemetry.
  add_header Cache-Control "no-cache" always;
  location ~ \.template$ { return 404; }
  location /ditto/ {
    proxy_pass http://ditto-nginx:80/;
    proxy_set_header Authorization "Basic ${DITTO_BASIC_AUTH}";
    proxy_http_version 1.1;
  }
}
